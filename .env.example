# Root settings are shared by local Python tools and Docker Compose.
# Existing backend/.env overrides root settings when running locally.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/recruit_ai
POSTGRES_DB=recruit_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=dev-secret-change-me-please-use-32-bytes-or-more
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost"]
EMBED_MODEL=models/cvjd-e5-base-profile-clean
EMBED_DEVICE=cpu
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
ALLOW_HASHING_FALLBACK=false
TASK_ALWAYS_EAGER=false
AUTO_CREATE_SCHEMA=false
SCORE_W_SEMANTIC=0.4
SCORE_W_SKILL=0.5
SCORE_W_EXP=0.1
SCORE_COS_FLOOR=0.5
SEPAY_BANK=MBBank
SEPAY_ACCOUNT=0000000000
SEPAY_ACCOUNT_NAME=NGUYEN VAN A
SEPAY_WEBHOOK_KEY=dev-sepay-key
ENABLE_DEV_TOOLS=false
# Demo: vẫn hiện VietQR SePay, thêm nút giả lập SePay gửi webhook (không cần chuyển khoản). Chạy thật: false
PAYMENT_DEMO_ENABLED=true
OPENROUTER_API_KEY=
# Phiên đăng nhập và tài khoản
REFRESH_TOKEN_DAYS=14
RESET_TOKEN_MINUTES=30
VERIFY_TOKEN_HOURS=48
REQUIRE_EMAIL_VERIFICATION=false
FRONTEND_URL=http://localhost
# Email: để trống SMTP_HOST thì email chỉ được ghi vào log backend/celery (dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Để trống để dùng JobMatch <SMTP_USER> làm người gửi.
SMTP_FROM=
SMTP_TLS=true
# Phỏng vấn
INTERVIEW_REMINDER_HOURS=24
INTERVIEW_CANCEL_MIN_HOURS=2
# Đối soát với API SePay (để trống: chỉ đối soát với webhook đã nhận)
SEPAY_API_TOKEN=
# Số tiến trình Celery worker; mỗi tiến trình nạp riêng model AI (~1 GB RAM)
CELERY_CONCURRENCY=2
